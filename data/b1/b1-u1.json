  "function": "Talk about what you have done in your life",
  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "What is the Present Perfect?",
          "body": "The Present Perfect connects the past and the present. It is used to talk about life experiences without saying exactly when they happened. We do NOT use it with specific past time expressions like 'yesterday' or 'in 2020'."
        },
        {
          "heading": "Form",
          "body": "Subject + have / has + past participle.",
          "tableHeader": true,
          "table": [
            ["Subject", "Form", "Example"],
            ["I / You / We / They", "have + past participle", "I have visited Paris."],
            ["He / She / It", "has + past participle", "She has been to London."],
            ["Negative", "have not / has not", "I have not seen that film."],
            ["Question", "Have / Has + subject", "Have you ever eaten sushi?"]
          ]
        },
        {
          "heading": "Irregular past participles",
          "tableHeader": true,
          "table": [
            ["Infinitive", "Past participle", "Example"],
            ["be", "been", "I have been to Italy."],
            ["go", "gone", "She has gone home."],
            ["see", "seen", "I have seen this film."],
            ["eat", "eaten", "We have eaten sushi."],
            ["do", "done", "He has done his homework."],
            ["write", "written", "I have written a letter."],
            ["take", "taken", "They have taken many photos."],
            ["speak", "spoken", "She has spoken to the manager."],
            ["break", "broken", "He has broken his leg."],
            ["lose", "lost", "I have lost my keys."]
          ]
        },
        {
          "heading": "Ever, never, just, already, yet",
          "body": "These words are commonly used with the Present Perfect.",
          "tableHeader": true,
          "table": [
            ["Word", "Use", "Example"],
            ["ever", "in questions", "Have you ever been to Japan?"],
            ["never", "negative meaning", "I have never eaten sushi."],
            ["just", "very recent actions", "She has just arrived."],
            ["already", "before now", "I have already finished."],
            ["yet", "until now (negatives, questions)", "I haven't finished yet."]
          ]
        },
        {
          "heading": "Present Perfect vs Past Simple",
          "body": "Present Perfect = no specific time. Past Simple = specific finished time.",
          "tableHeader": true,
          "table": [
            ["Tense", "Use", "Example"],
            ["Present Perfect", "experience without time", "I have visited Paris."],
            ["Past Simple", "specific time", "I visited Paris in 2020."],
            ["Present Perfect", "recent news", "I have lost my keys."],
            ["Past Simple", "past detail", "I lost my keys yesterday."]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not say 'I have visit'. Say 'I have visited'.",
            "Do not use Present Perfect with 'yesterday', 'last week' or specific past times.",
            "Do not confuse 'gone' (still there) with 'been' (went and came back)."
          ]
        }
      ]
    },
