        {
          "heading": "Key rules",
          "list": [
            "Present Perfect: have / has + past participle.",
            "Use it for experiences without a specific time.",
            "Ever in questions, never in affirmative sentences with negative meaning.",
            "Just for very recent actions. Already for actions before now. Yet in negatives and questions.",
            "Do NOT use Present Perfect with specific past times."
          ]
        },
