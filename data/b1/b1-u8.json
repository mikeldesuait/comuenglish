{
  "id": "b1-u8",
  "title": "Reported speech",
  "grammar": "Reported statements, questions and commands",
  "vocabulary": "Conversations, messages, rumours",
  "function": "Report what someone said",
  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "What is reported speech?",
          "body": "Reported speech is when we tell someone what another person said, without using their exact words. When we report, the tenses usually move back one step."
        },
        {
          "heading": "Tense changes",
          "tableHeader": true,
          "table": [
            [
              "Direct speech",
              "Reported speech"
            ],
            [
              "Present Simple",
              "Past Simple"
            ],
            [
              "Present Continuous",
              "Past Continuous"
            ],
            [
              "Past Simple",
              "Past Perfect"
            ],
            [
              "Present Perfect",
              "Past Perfect"
            ],
            [
              "Will",
              "Would"
            ],
            [
              "Can",
              "Could"
            ],
            [
              "Must",
              "Had to"
            ]
          ]
        },
        {
          "heading": "Examples",
          "tableHeader": true,
          "table": [
            [
              "Direct",
              "Reported"
            ],
            [
              "I am tired.",
              "She said she was tired."
            ],
            [
              "I am working.",
              "He said he was working."
            ],
            [
              "I saw a film.",
              "She said she had seen a film."
            ],
            [
              "I will come.",
              "He said he would come."
            ],
            [
              "I can help.",
              "She said she could help."
            ]
          ]
        },
        {
          "heading": "Reported questions",
          "body": "When we report questions, we use the same word order as statements (no auxiliary).",
          "list": [
            "Where do you live? → He asked where I lived.",
            "Do you like pizza? → She asked if I liked pizza.",
            "What time is it? → He asked what time it was.",
            "Are you coming? → She asked if I was coming."
          ]
        },
        {
          "heading": "Reported commands",
          "body": "Use 'told' + object + to + verb for positive commands, 'told' + object + not to + verb for negative.",
          "list": [
            "Close the door. → She told me to close the door.",
            "Don't touch that. → He told me not to touch that.",
            "Be quiet. → The teacher told us to be quiet."
          ]
        },
        {
          "heading": "Say vs Tell",
          "tableHeader": true,
          "table": [
            [
              "Verb",
              "Use",
              "Example"
            ],
            [
              "say",
              "no object",
              "She said she was tired."
            ],
            [
              "tell",
              "with object",
              "She told me she was tired."
            ]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not forget to change the tense.",
            "Do not use 'say' with a person: 'She said me' is wrong. Use 'She told me'.",
            "In reported questions, use statement word order (no auxiliary)."
          ]
        }
      ]
    },
