    {
      "name": "Summary",
      "type": "theory",
      "sections": [
        {
          "heading": "Key rules",
          "list": [
            "Reported speech: tenses move back one step.",
            "Present Simple → Past Simple. Past Simple → Past Perfect.",
            "Will → Would. Can → Could. Must → Had to.",
            "Say without object, tell with object.",
            "Reported questions use statement word order and 'if' for yes/no questions.",
            "Reported commands: told + object + to / not to + verb."
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Forgetting to change the tense.",
            "Using 'say' with a person.",
            "Using question word order in reported questions."
          ]
        },
        {
          "heading": "Useful phrases",
          "list": [
            "She said (that)...",
            "He told me (that)...",
            "They asked if...",
            "I asked where...",
            "She promised to...",
            "He warned me not to..."
          ]
        }
      ]
    }
