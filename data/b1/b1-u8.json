    {
      "name": "Guided practice",
      "type": "exercise",
      "questions": [
        {
          "prompt": "He said he ___ busy.",
          "options": [
            "is",
            "was",
            "will be",
            "be"
          ],
          "correct": 1,
          "explanation": "Present Simple becomes Past Simple in reported speech."
        },
        {
          "prompt": "She asked me ___ I liked pizza.",
          "options": [
            "that",
            "if",
            "what",
            "which"
          ],
          "correct": 1,
          "explanation": "Yes/no questions are reported with if or whether."
        },
        {
          "prompt": "He ___ me to close the door.",
          "options": [
            "said",
            "told",
            "asked",
            "spoke"
          ],
          "correct": 1,
          "explanation": "Tell is used with an object pronoun."
        },
        {
          "prompt": "She said she ___ help me.",
          "options": [
            "can",
            "could",
            "will",
            "would"
          ],
          "correct": 1,
          "explanation": "Can becomes could in reported speech."
        },
        {
          "prompt": "They asked where I ___ .",
          "options": [
            "live",
            "lived",
            "will live",
            "living"
          ],
          "correct": 1,
          "explanation": "Present Simple becomes Past Simple."
        },
        {
          "prompt": "He told me ___ touch the paintings.",
          "options": [
            "not to",
            "to not",
            "don't",
            "not"
          ],
          "correct": 0,
          "explanation": "Negative command: told + not to + verb."
        },
        {
          "prompt": "She said she ___ the film.",
          "options": [
            "saw",
            "has seen",
            "had seen",
            "will see"
          ],
          "correct": 2,
          "explanation": "Past Simple becomes Past Perfect."
        },
        {
          "prompt": "He said he ___ come to the party.",
          "options": [
            "will",
            "would",
            "can",
            "could"
          ],
          "correct": 1,
          "explanation": "Will becomes would."
        },
        {
          "prompt": "She asked me what time ___ .",
          "options": [
            "is it",
            "it is",
            "it was",
            "was it"
          ],
          "correct": 2,
          "explanation": "In reported questions we use statement word order."
        },
        {
          "prompt": "He ___ that he was sorry.",
          "options": [
            "said",
            "told",
            "asked",
            "spoke"
          ],
          "correct": 0,
          "explanation": "Say is used without an object person."
        }
      ]
    },
