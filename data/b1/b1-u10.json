        {
          "heading": "Comparatives review",
          "body": "We use comparatives to compare two things.",
          "tableHeader": true,
          "table": [
            [
              "Adjective type",
              "Form",
              "Example"
            ],
            [
              "Short",
              "-er + than",
              "She is taller than me."
            ],
            [
              "Long",
              "more + adjective + than",
              "This book is more interesting."
            ],
            [
              "Irregular",
              "better / worse / further",
              "This is better than that."
            ]
          ]
        },
        {
          "heading": "Equality and inequality",
          "list": [
            "As + adjective + as: She is as tall as her sister.",
            "Not as + adjective + as: He is not as tall as his brother.",
            "Less + adjective + than: This is less expensive than that one."
          ]
        },
        {
          "heading": "Both / Either / Neither",
          "tableHeader": true,
          "table": [
            [
              "Word",
              "Meaning",
              "Example"
            ],
            [
              "both",
              "the two",
              "Both films were good."
            ],
            [
              "either",
              "one or the other",
              "You can take either bus."
            ],
            [
              "neither",
              "not one, not the other",
              "Neither of them came."
            ]
          ]
        },
        {
          "heading": "Both / Either / Neither with nouns",
          "list": [
            "Both + plural: Both restaurants are good.",
            "Either + singular: Either restaurant is fine.",
            "Neither + singular: Neither restaurant is open.",
            "Neither of + plural: Neither of the restaurants is open."
          ]
        },
        {
          "heading": "Preferences",
          "tableHeader": true,
          "table": [
            [
              "Structure",
              "Meaning",
              "Example"
            ],
            [
              "I prefer A to B",
              "general preference",
              "I prefer tea to coffee."
            ],
            [
              "I would rather A than B",
              "specific preference",
              "I would rather stay home than go out."
            ],
            [
              "I like A better than B",
              "informal",
              "I like tea better than coffee."
            ]
          ]
        },
        {
          "heading": "Question tags",
          "body": "Question tags are short questions at the end of a sentence. If the sentence is positive, the tag is negative. If the sentence is negative, the tag is positive.",
          "tableHeader": true,
          "table": [
            [
              "Sentence",
              "Tag",
              "Full"
            ],
            [
              "You are Spanish.",
              "aren't you?",
              "You are Spanish, aren't you?"
            ],
            [
              "She doesn't like coffee.",
              "does she?",
              "She doesn't like coffee, does she?"
            ],
            [
              "They went home.",
              "didn't they?",
              "They went home, didn't they?"
            ],
            [
              "We can help.",
              "can't we?",
              "We can help, can't we?"
            ]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not say 'more better'. Use 'better'.",
            "Do not say 'neither of them came' with plural agreement issues. Use 'neither of them came' (standard).",
            "Question tags use the same auxiliary as the sentence."
          ]
