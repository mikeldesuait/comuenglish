  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "What is the passive voice?",
          "body": "We use the passive voice when the action is more important than who does it, or when we don't know who does it. The object of the active sentence becomes the subject of the passive sentence."
        },
        {
          "heading": "Form",
          "body": "Subject + be + past participle (+ by + agent).",
          "tableHeader": true,
          "table": [
            [
              "Tense",
              "Form",
              "Example"
            ],
            [
              "Present Simple",
              "am / is / are + past participle",
              "The letter is written every day."
            ],
            [
              "Past Simple",
              "was / were + past participle",
              "The book was written in 1990."
            ],
            [
              "Negative",
              "am/is/are/was/were + not + past participle",
              "The window was not cleaned."
            ],
            [
              "Question",
              "Am/Is/Are/Was/Were + subject + past participle?",
              "Was the letter sent?"
            ]
          ]
        },
        {
          "heading": "Active vs Passive",
          "tableHeader": true,
          "table": [
            [
              "Active",
              "Passive"
            ],
            [
              "Shakespeare wrote Hamlet.",
              "Hamlet was written by Shakespeare."
            ],
            [
              "They clean the office every day.",
              "The office is cleaned every day."
            ],
            [
              "Someone stole my bike.",
              "My bike was stolen."
            ]
          ]
        },
        {
          "heading": "When to use the passive",
          "list": [
            "When the doer is unknown: My phone was stolen.",
            "When the doer is obvious: The thief was arrested. (obviously by police)",
            "When the action is more important: English is spoken all over the world.",
            "In scientific and formal writing: The experiment was conducted..."
          ]
        },
        {
          "heading": "By + agent",
          "body": "We use 'by' to say who or what does the action, but only if it is important information.",
          "list": [
            "Hamlet was written by Shakespeare.",
            "The song was composed by a famous musician.",
            "The window was broken by the children."
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not forget the verb 'to be': 'The letter sent' is wrong. Say 'The letter was sent'.",
            "Use the past participle, not the past simple: 'It was wrote' is wrong. Say 'It was written'.",
            "Learn irregular past participles by heart."
          ]
        }
      ]
    },
