    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "Telling a story in the past",
          "body": "In English, we often combine the Past Simple and the Past Continuous to tell stories. The Past Continuous describes the background or an action in progress. The Past Simple describes a short action or interruption."
        },
        {
          "heading": "Past Continuous form",
          "body": "Subject + was / were + verb-ing.",
          "tableHeader": true,
          "table": [
            [
              "Subject",
              "Form",
              "Example"
            ],
            [
              "I / He / She / It",
              "was + verb-ing",
              "I was reading a book."
            ],
            [
              "You / We / They",
              "were + verb-ing",
              "They were playing football."
            ]
          ]
        },
        {
          "heading": "Past Simple vs Past Continuous",
          "tableHeader": true,
          "table": [
            [
              "Tense",
              "Use",
              "Example"
            ],
            [
              "Past Continuous",
              "background action",
              "I was walking home."
            ],
            [
              "Past Simple",
              "short interruption",
              "I saw an old friend."
            ],
            [
              "Both combined",
              "typical narrative",
              "I was walking home when I saw an old friend."
            ]
          ]
        },
        {
          "heading": "When and while",
          "list": [
            "When + Past Simple: I was reading when the phone rang.",
            "While + Past Continuous: While I was reading, the phone rang.",
            "Two simultaneous actions: I was cooking while she was watching TV."
          ]
        },
        {
          "heading": "Time expressions",
          "list": [
            "at 8 pm yesterday, at that moment",
            "this time last week",
            "while, when, as, suddenly",
            "first, then, after that, finally"
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not forget 'was/were': 'I reading' is wrong. Say 'I was reading'.",
            "Do not use Past Continuous for short finished actions. Use Past Simple.",
            "Remember: he/she/it + was; you/we/they + were."
          ]
        }
      ]
    },
