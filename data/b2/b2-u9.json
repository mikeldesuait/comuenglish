    {
      "name": "Guided practice",
      "type": "exercise",
      "questions": [
        {"prompt": "His ___ (care) caused the accident.", "options": ["care", "careful", "careless", "carelessly"], "correct": 2, "explanation": "We need an adjective describing a person: careless."},
        {"prompt": "The ___ (decide) was very difficult to make.", "options": ["decide", "deciding", "decision", "decisive"], "correct": 2, "explanation": "The noun form of decide is decision."},
        {"prompt": "She is a very ___ (create) artist.", "options": ["create", "creation", "creative", "creatively"], "correct": 2, "explanation": "Adjective form of create is creative."},
        {"prompt": "He solved the problem ___ (success).", "options": ["succeed", "success", "successful", "successfully"], "correct": 3, "explanation": "Adverb form: successfully."},
        {"prompt": "It is ___ (possible) to finish this today.", "options": ["possible", "impossible", "unpossible", "dispossible"], "correct": 1, "explanation": "Correct prefix for possible is im-."},
        {"prompt": "This is an ___ (regular) verb.", "options": ["unregular", "inregular", "irregular", "disregular"], "correct": 2, "explanation": "Correct prefix for regular is ir-."},
        {"prompt": "She was very ___ (happy) about the news.", "options": ["happy", "happiness", "unhappy", "happily"], "correct": 2, "explanation": "Context suggests negative: unhappy."},
        {"prompt": "Her ___ (beautiful) is famous.", "options": ["beautiful", "beauty", "beautifully", "beautify"], "correct": 1, "explanation": "The noun form of beautiful is beauty."},
        {"prompt": "He is a ___ (science) at the university.", "options": ["science", "scientific", "scientist", "scientifically"], "correct": 2, "explanation": "Person noun: scientist."},
        {"prompt": "Please read the ___ (instruct) carefully.", "options": ["instruct", "instructor", "instructions", "instructive"], "correct": 2, "explanation": "The noun form is instructions."}
      ]
