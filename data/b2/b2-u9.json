{
  "id": "b2-u9",
  "title": "Word formation",
  "grammar": "Prefixes, suffixes, compound words",
  "vocabulary": "Word families",
  "function": "Expand vocabulary from known roots",
  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "What is word formation?",
          "body": "Word formation is the process of creating new words from existing ones using prefixes, suffixes or compounds. It is essential for the B2 Use of English paper."
        },
        {
          "heading": "Prefixes (change meaning)",
          "tableHeader": true,
          "table": [
            ["Prefix", "Meaning", "Examples"],
            ["un-", "not / opposite", "happy → unhappy, fair → unfair"],
            ["dis-", "not / opposite", "agree → disagree, honest → dishonest"],
            ["in- / im- / il- / ir-", "not", "correct → incorrect, possible → impossible, legal → illegal, regular → irregular"],
            ["re-", "again", "do → redo, write → rewrite"],
            ["pre-", "before", "view → preview, historic → prehistoric"],
            ["mis-", "wrongly", "understand → misunderstand, spell → misspell"],
            ["over-", "too much", "work → overwork, eat → overeat"],
            ["under-", "not enough", "estimate → underestimate, paid → underpaid"]
          ]
        },
        {
          "heading": "Suffixes (change word class)",
          "tableHeader": true,
          "table": [
            ["Suffix", "Forms", "Examples"],
            ["-tion / -sion", "noun from verb", "decide → decision, act → action"],
            ["-ment", "noun from verb", "develop → development, agree → agreement"],
            ["-ness", "noun from adjective", "happy → happiness, dark → darkness"],
            ["-ity", "noun from adjective", "real → reality, possible → possibility"],
            ["-er / -or", "person who does", "teach → teacher, act → actor"],
            ["-ist", "person (profession)", "art → artist, science → scientist"],
            ["-ful", "adjective (full of)", "care → careful, beauty → beautiful"],
            ["-less", "adjective (without)", "care → careless, hope → hopeless"],
            ["-able / -ible", "adjective (can be)", "read → readable, access → accessible"],
            ["-ive", "adjective", "create → creative, attract → attractive"],
            ["-ly", "adverb", "quick → quickly, happy → happily"]
          ]
        },
        {
          "heading": "Same root, different forms",
          "tableHeader": true,
          "table": [
            ["Verb", "Noun", "Adjective", "Adverb"],
            ["decide", "decision", "decisive", "decisively"],
            ["create", "creation", "creative", "creatively"],
            ["succeed", "success", "successful", "successfully"],
            ["differ", "difference", "different", "differently"],
            ["beauty", "-", "beautiful", "beautifully"]
          ]
        },
        {
          "heading": "Compound words",
          "list": [
            "Noun + noun: toothbrush, football, bedroom",
            "Adjective + noun: blackboard, greenhouse, smartphone",
            "Verb + noun: washing machine, swimming pool",
            "Noun + verb: sunrise, heartbeat",
            "Preposition + noun: underground, overtime"
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not confuse adjectives with adverbs: 'She sings beautiful' is wrong. Say 'beautifully'.",
            "Check the correct prefix: 'unpossible' is wrong. Say 'impossible'.",
            "Some words have both -ful and -less forms with different meanings: careful / careless."
          ]
        }
      ]
    },
    {
