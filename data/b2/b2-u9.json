        {"prompt": "His ___ (care) caused the accident.", "options": ["care", "careful", "careless", "carefully"], "correct": 2, "explanation": "Careless = lacking care."},
        {"prompt": "The ___ (decide) was difficult.", "options": ["decide", "decision", "decisive", "decisively"], "correct": 1, "explanation": "Noun form: decision."},
        {"prompt": "She is a very ___ (create) person.", "options": ["create", "creative", "creativity", "creatively"], "correct": 1, "explanation": "Adjective: creative."},
        {"prompt": "He worked ___ (success) on the project.", "options": ["success", "successful", "successfully", "succeed"], "correct": 2, "explanation": "Adverb: successfully."},
        {"prompt": "It is ___ (possible) to park here.", "options": ["possible", "impossible", "unpossible", "dispossible"], "correct": 1, "explanation": "Correct prefix: im-."},
        {"prompt": "This is an ___ (regular) verb.", "options": ["unregular", "irregular", "inregular", "disregular"], "correct": 1, "explanation": "Prefix ir- before r."},
        {"prompt": "Her ___ (happy) was clear.", "options": ["happy", "happiness", "unhappy", "happily"], "correct": 1, "explanation": "Noun form: happiness."},
        {"prompt": "The ___ (develop) of the city was rapid.", "options": ["develop", "development", "developer", "developing"], "correct": 1, "explanation": "Noun: development."},
        {"prompt": "He is a famous ___ (art).", "options": ["art", "artist", "artistic", "artistically"], "correct": 1, "explanation": "Person noun: artist."},
        {"prompt": "Be ___ (care) with the glass.", "options": ["care", "careful", "careless", "carefully"], "correct": 1, "explanation": "Adjective: careful."}
      ]
    },
    {
      "name": "Summary",
      "type": "theory",
      "sections": [
        {
          "heading": "Key rules",
          "list": [
            "Prefixes change meaning: un-, dis-, in-/im-/il-/ir-, re-, pre-, mis-, over-, under-.",
            "Suffixes change word class: -tion, -ment, -ness, -ity, -er, -or, -ist, -ful, -less, -able, -ive, -ly.",
            "Same root can produce 4 forms: verb, noun, adjective, adverb.",
            "Compound words: toothbrush, football, swimming pool, sunrise."
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not confuse adjectives and adverbs.",
            "Choose the correct prefix: im- before p/b/m; ir- before r; il- before l.",
            "Careful vs careless have opposite meanings."
          ]
        },
        {
          "heading": "Useful phrases",
          "list": [
            "happy → unhappy → happiness → happily",
            "care → careful → careless → carefully",
            "decide → decision → decisive → decisively",
            "possible → impossible",
            "regular → irregular"
