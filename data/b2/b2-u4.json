    {
      "name": "Summary",
      "type": "theory",
      "sections": [
        {
          "heading": "Key rules",
          "list": [
            "Reporting verbs + to + verb: offer, promise, agree, refuse, threaten.",
            "Reporting verbs + object + to + verb: tell, ask, warn, remind, invite.",
            "Reporting verbs + gerund: admit, deny, suggest, recommend, apologise for.",
            "Reporting verbs + that clause: say, admit, complain, explain, insist.",
            "Say has no object. Tell requires an object."
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not confuse say and tell.",
            "Do not use 'to' after suggest + gerund.",
            "Do not forget the tense shift when reporting."
          ]
        },
        {
          "heading": "Useful phrases",
          "list": [
            "She offered to...",
            "He denied...-ing.",
