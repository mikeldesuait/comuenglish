  "title": "Obligation and permission",
  "grammar": "Can/Can not, Must/Must not, Imperatives",
  "vocabulary": "Rules, signs, instructions",
  "function": "Give orders, ask permission, express prohibition",
  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "Modal verbs for obligation and permission",
          "body": "Modal verbs are special verbs that express obligation, permission, ability or prohibition. They do not change form and are followed by the base verb (without 'to')."
        },
        {
          "heading": "Can / Can't",
          "body": "'Can' is used to ask for permission and to express ability. 'Can't' means it is not allowed.",
          "tableHeader": true,
          "table": [
            [
              "Use",
              "Example"
            ],
            [
              "Permission",
              "Can I open the window?"
            ],
            [
              "Ability",
              "She can swim very well."
            ],
            [
              "Prohibition",
              "You can't park here."
            ]
          ]
        },
        {
          "heading": "Must / Mustn't",
          "body": "'Must' expresses strong obligation. 'Mustn't' means it is forbidden.",
          "tableHeader": true,
          "table": [
            [
              "Use",
              "Example"
            ],
            [
              "Obligation",
              "You must wear a seatbelt."
            ],
            [
              "Prohibition",
              "You mustn't smoke here."
            ],
            [
              "Rules",
              "Students must arrive on time."
            ]
          ]
        },
        {
          "heading": "Imperatives",
          "body": "Imperatives give direct instructions or orders. The imperative uses the base form of the verb. Negative: Don't + verb.",
          "tableHeader": true,
          "table": [
            [
              "Positive",
              "Negative"
            ],
            [
              "Turn off your phone.",
              "Don't use your phone."
            ],
            [
              "Close the door.",
              "Don't open the window."
            ],
            [
              "Sit down, please.",
              "Don't run in the corridor."
            ]
          ]
        },
        {
          "heading": "Have to / Don't have to",
          "body": "'Have to' expresses external obligation (a rule from outside). 'Don't have to' means there is no obligation.",
          "list": [
            "I have to wear a uniform at school.",
            "She has to work on Saturdays.",
            "You don't have to come. (It's optional.)"
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not use 'to' after a modal verb: 'You must to go' is wrong. Say 'You must go'.",
            "Do not add -s to modal verbs: 'She musts go' is wrong.",
            "Do not confuse 'mustn't' (forbidden) with 'don't have to' (not necessary)."
          ]
        }
      ]
    },
