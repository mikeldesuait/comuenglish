  "phases": [
    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "What is the verb To Be?",
          "body": "The verb 'to be' is used to say who you are, how you feel, and where you are from."
        },
        {
          "heading": "Form",
          "tableHeader": true,
          "table": [
            [
              "Subject",
              "Verb",
              "Example"
            ],
            [
              "I",
              "am",
              "I am Maria."
            ],
            [
              "You",
              "are",
              "You are my friend."
            ],
            [
              "He",
              "is",
              "He is my brother."
            ],
            [
              "She",
              "is",
              "She is my sister."
            ],
            [
              "It",
              "is",
              "It is a dog."
            ],
            [
              "We",
              "are",
              "We are students."
            ],
            [
              "They",
              "are",
              "They are from Italy."
            ]
          ]
        },
        {
          "heading": "Negative",
          "body": "Add 'not' after the verb.",
          "list": [
            "I am not tall.",
            "He is not a teacher.",
            "They are not at home."
          ]
        },
        {
          "heading": "Questions",
          "body": "Put the verb before the subject.",
          "list": [
            "Are you from Spain?",
            "Is she your friend?",
            "Are they students?"
          ]
        },
        {
          "heading": "Possessive adjectives",
          "body": "They show who owns something.",
          "tableHeader": true,
          "table": [
            [
              "Subject",
              "Possessive",
              "Example"
            ],
            [
              "I",
              "my",
              "My name is Tom."
            ],
            [
              "You",
              "your",
              "Your car is new."
            ],
            [
              "He",
              "his",
              "His eyes are green."
            ],
            [
              "She",
              "her",
              "Her mother is a nurse."
            ],
            [
              "It",
              "its",
              "Its tail is short."
            ],
            [
              "We",
              "our",
              "Our house is big."
            ],
            [
              "They",
              "their",
              "Their children are young."
            ]
          ]
        },
        {
          "heading": "Have got",
          "body": "Used for possession, family and body parts.",
          "tableHeader": true,
          "table": [
            [
              "Subject",
              "Verb",
              "Example"
            ],
            [
              "I / You / We / They",
              "have got",
              "I have got two brothers."
            ],
            [
              "He / She / It",
              "has got",
              "She has got long hair."
            ]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not say 'I have 12 years'. Say 'I am 12'.",
            "Do not say 'He have got'. Say 'He has got'.",
            "Do not confuse 'its' (possession) and 'it's' (it is)."
          ]
        }
      ]
