    {
      "name": "Summary",
      "type": "theory",
      "sections": [
        {
          "heading": "Key rules",
          "list": [
            "Present Perfect: have / has + past participle.",
            "Use it for experiences without a specific time.",
            "Ever in questions, never in affirmative sentences.",
            "Just for very recent actions.",
            "Already in affirmative, yet in negative and questions.",
            "Do NOT use Present Perfect with specific past times."
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not say 'I have visit'. Say 'I have visited'.",
            "Do not use Present Perfect with 'yesterday' or 'last week'.",
            "Do not confuse 'gone' (still there) with 'been' (went and came back)."
          ]
        },
        {
          "heading": "Useful phrases",
          "list": [
