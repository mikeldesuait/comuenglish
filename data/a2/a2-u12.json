      "sections": [
        {
          "heading": "What is the Present Perfect?",
          "body": "The Present Perfect connects the past and the present. It is used to talk about experiences, recent events and situations that started in the past and continue now. We do NOT use it with specific past time expressions like 'yesterday' or 'last week'."
        },
        {
          "heading": "Form",
          "body": "Subject + have / has + past participle.",
          "tableHeader": true,
          "table": [
            [
              "Subject",
              "Form",
              "Example"
            ],
            [
              "I / You / We / They",
              "have + past participle",
              "I have visited Paris."
            ],
            [
              "He / She / It",
              "has + past participle",
              "She has been to London."
            ]
          ]
        },
        {
          "heading": "Irregular past participles",
          "tableHeader": true,
          "table": [
            [
              "Infinitive",
              "Past participle",
              "Example"
            ],
            [
              "be",
              "been",
              "I have been to Italy."
            ],
            [
              "go",
              "gone",
              "She has gone home."
            ],
            [
              "see",
              "seen",
              "I have seen this film."
            ],
            [
              "eat",
              "eaten",
              "We have eaten sushi."
            ],
            [
              "do",
              "done",
              "He has done his homework."
            ],
            [
              "have",
              "had",
              "I have had three cups of coffee."
            ],
            [
              "make",
              "made",
              "She has made a cake."
            ],
            [
              "write",
              "written",
              "I have written a letter."
            ],
            [
              "take",
              "taken",
              "They have taken many photos."
            ],
            [
              "read",
              "read",
              "I have read that book."
            ]
          ]
        },
        {
          "heading": "Ever / Never",
          "body": "Use 'ever' in questions, 'never' in affirmative sentences with negative meaning.",
          "list": [
            "Have you ever been to Japan?",
            "I have never eaten sushi.",
            "She has never seen snow."
          ]
        },
        {
          "heading": "Just",
          "body": "Use 'just' for very recent actions.",
          "list": [
            "I have just finished my homework.",
            "She has just arrived.",
            "They have just left."
          ]
        },
        {
          "heading": "Present Perfect vs Past Simple",
          "tableHeader": true,
          "table": [
            [
              "Tense",
              "Use",
              "Example"
            ],
            [
              "Present Perfect",
              "experience, no specific time",
              "I have visited Paris."
            ],
            [
              "Past Simple",
              "specific finished time",
              "I visited Paris in 2020."
            ]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not use Present Perfect with 'yesterday', 'last week' or other finished times. Use Past Simple.",
            "Do not say 'I have visit'. Say 'I have visited'.",
            "Do not confuse 'gone' (not here) with 'been' (went and came back)."
          ]
        }
      ]
    },
