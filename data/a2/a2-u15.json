    {
      "name": "Grammar explanation",
      "type": "theory",
      "sections": [
        {
          "heading": "Talking about health",
          "body": "To talk about health problems we use 'have got' or 'have' + a noun. We also use 'I feel...' to describe how we feel.",
          "tableHeader": true,
          "table": [
            [
              "Structure",
              "Example"
            ],
            [
              "I have got a + noun",
              "I have got a headache."
            ],
            [
              "He / She has got a + noun",
              "She has got a cold."
            ],
            [
              "I feel + adjective",
              "I feel tired."
            ],
            [
              "I don't feel + adjective",
              "I don't feel well."
            ]
          ]
        },
        {
          "heading": "Should and shouldn't",
          "body": "Use 'should' to give advice and 'shouldn't' to say what is not a good idea.",
          "list": [
            "You should see a doctor.",
            "You should drink a lot of water.",
            "You shouldn't eat too much sugar.",
            "You shouldn't go to work if you are ill."
          ]
        },
        {
          "heading": "At the doctor's",
          "list": [
            "What's the matter?",
            "I don't feel well.",
            "I have got a pain in my...",
            "It hurts here.",
            "I have got a temperature.",
            "You should take this medicine twice a day."
          ]
        },
        {
          "heading": "Describing feelings",
          "body": "Adjectives for emotions. Remember: -ed for how YOU feel, -ing for what causes the feeling.",
          "tableHeader": true,
          "table": [
            [
              "Feeling",
              "Example"
            ],
            [
              "happy",
              "I am happy today."
            ],
            [
              "sad",
              "She feels sad."
            ],
            [
              "tired",
              "He is very tired."
            ],
            [
              "angry",
              "I am angry with my brother."
            ],
            [
              "excited",
              "We are excited about the trip."
            ],
            [
              "worried",
              "She is worried about the exam."
            ],
            [
              "bored",
              "The students are bored."
            ],
            [
              "surprised",
              "I am surprised to see you."
            ],
            [
              "scared",
              "He is scared of dogs."
            ]
          ]
        },
        {
          "heading": "Common mistakes",
          "list": [
            "Do not say 'I have pain in the head'. Say 'I have got a headache'.",
            "Do not say 'I am boring'. Say 'I am bored'.",
            "Do not confuse 'should' (advice) with 'must' (obligation)."
          ]
        }
